<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Flozzy
    </title>


    <link
        rel="icon"
        type="image/png"
        href="/ikon.png"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >


    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >



<style>


/* =========================================================
   RESET
========================================================= */

* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

    font-family:
        'Poppins',
        sans-serif;

}


html,
body {

    width: 100%;

    min-height: 100%;

}


body {

    min-height: 100vh;

    color: #ffffff;

    background:
        #050505;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 10px;

    position: relative;

    overflow: hidden;

    padding: 20px;

}



/* =========================================================
   BACKGROUND OVERLAY
========================================================= */

body::after {

    content: '';

    position: fixed;

    inset: 0;

    pointer-events: none;

    z-index: -1;

    background:

        radial-gradient(
            circle at 50% 30%,
            rgba(255,255,255,.035),
            transparent 37%
        ),

        linear-gradient(
            180deg,
            rgba(0,0,0,.07),
            rgba(0,0,0,.35)
        );

}



/* =========================================================
   BACKGROUND VIDEO
========================================================= */

.bg-video {

    position: fixed;

    top: 50%;

    left: 50%;

    transform:
        translate(-50%, -50%);

    min-width: 100vw;

    min-height: 100vh;

    width: auto;

    height: auto;

    object-fit: cover;

    z-index: -3;

}



/* =========================================================
   ENTER
========================================================= */

#enterOverlay {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100vh;

    background:
        rgba(5,5,5,.91);

    backdrop-filter:
        blur(15px);

    -webkit-backdrop-filter:
        blur(15px);

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    transition:
        opacity .5s ease;

}


.enter-text {

    font-size: 20px;

    font-weight: 600;

    color:
        rgba(255,255,255,.94);

    letter-spacing: 1px;

    animation:
        enterPulse
        1.4s
        ease-in-out
        infinite
        alternate;

}


@keyframes enterPulse {

    from {

        opacity: .35;

        transform:
            scale(.98);

    }


    to {

        opacity: 1;

        transform:
            scale(1);

    }

}



/* =========================================================
   VIEW COUNTER
========================================================= */

.view-counter {

    position: fixed;

    top: 18px;

    right: 18px;

    z-index: 50;

    display: flex;

    align-items: center;

    gap: 8px;

    padding:
        8px 13px;

    border-radius:
        16px;

    background:
        rgba(10,10,14,.34);

    border:
        1px solid
        rgba(255,255,255,.08);

    backdrop-filter:
        blur(16px);

    -webkit-backdrop-filter:
        blur(16px);

    box-shadow:
        0 10px 25px
        rgba(0,0,0,.25);

    color:
        rgba(255,255,255,.75);

    font-size: 12px;

}



/* =========================================================
   AUDIO
========================================================= */

.audio-control {

    position: fixed;

    left: 18px;

    bottom: 18px;

    z-index: 50;

    display: flex;

    align-items: center;

    gap: 8px;

    padding:
        8px 12px;

    border-radius:
        16px;

    background:
        rgba(10,10,14,.34);

    border:
        1px solid
        rgba(255,255,255,.08);

    backdrop-filter:
        blur(16px);

    -webkit-backdrop-filter:
        blur(16px);

    box-shadow:
        0 10px 25px
        rgba(0,0,0,.25);

}


.audio-control button {

    width: 24px;

    border: none;

    background:
        transparent;

    color: #ffffff;

    cursor: pointer;

    font-size: 14px;

}


.audio-slider {

    width: 75px;

    height: 4px;

    cursor: pointer;

    accent-color:
        #b7a5ff;

}



/* =========================================================
   BÜYÜK AVATAR
========================================================= */

.avatar-container {

    /*
        Büyük profil fotoğrafı:
        110px

        Discord decoration:
        120px

        Kanat büyük PP'de kalıyor.
    */

    --avatar-size:
        110px;

    --decoration-size:
        120px;


    position: relative;

    width: 132px;

    height: 132px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 3px;

}


.main-avatar {

    position: absolute;

    top: 50%;

    left: 50%;

    width:
        var(--avatar-size);

    height:
        var(--avatar-size);

    transform:
        translate(-50%, -50%);

    border-radius:
        50%;

    object-fit:
        cover;

    z-index:
        1;

    box-shadow:

        0 0 0 1px
        rgba(255,255,255,.10),

        0 12px 35px
        rgba(0,0,0,.30);

}


.avatar-frame {

    position: absolute;

    top: 50%;

    left: 50%;

    width:
        var(--decoration-size);

    height:
        var(--decoration-size);

    transform:
        translate(-50%, -50%);

    object-fit:
        contain;

    z-index:
        2;

    pointer-events:
        none;

    display:
        none;

}



/* =========================================================
   NAME
========================================================= */

.glow-username {

    font-size:
        35px;

    line-height:
        1;

    font-weight:
        800;

    color:
        #ffffff;

    text-shadow:

        0 0 12px
        rgba(255,255,255,.68),

        0 0 30px
        rgba(255,255,255,.20);

}



/* =========================================================
   BIO
========================================================= */

.bio-text {

    margin:
        5px 0 9px;

    padding:
        0 12px;

    max-width:
        500px;

    text-align:
        center;

    font-size:
        13px;

    color:
        rgba(255,255,255,.78);

}



/* =========================================================
   DISCORD CARD
========================================================= */

.discord-card {

    position: relative;

    overflow: hidden;

    width:
        390px;

    max-width:
        calc(100vw - 30px);

    padding:
        16px;

    border-radius:
        23px;

    background:

        linear-gradient(
            135deg,
            rgba(8,8,12,.31),
            rgba(32,32,40,.18)
        );

    border:
        1px solid
        rgba(255,255,255,.085);

    backdrop-filter:
        blur(19px)
        saturate(120%);

    -webkit-backdrop-filter:
        blur(19px)
        saturate(120%);

    box-shadow:

        0 18px 50px
        rgba(0,0,0,.32),

        inset 0 1px 0
        rgba(255,255,255,.035);

}


.discord-card::before {

    content: '';

    position: absolute;

    width:
        220px;

    height:
        220px;

    right:
        -100px;

    top:
        -115px;

    pointer-events:
        none;

    background:

        radial-gradient(
            circle,
            rgba(255,255,255,.11),
            transparent 67%
        );

}



/* =========================================================
   CARD TOP
========================================================= */

.card-top {

    position: relative;

    z-index:
        2;

    display: flex;

    align-items: center;

    gap:
        14px;

}



/* =========================================================
   KÜÇÜK AVATAR

   BURADA ARTIK KANAT YOK.
========================================================= */

.card-avatar-wrapper {

    position: relative;

    width:
        59px;

    height:
        59px;

    flex-shrink:
        0;

}


.card-avatar {

    width:
        59px;

    height:
        59px;

    border-radius:
        50%;

    object-fit:
        cover;

    border:
        1px solid
        rgba(255,255,255,.09);

    box-shadow:
        0 7px 18px
        rgba(0,0,0,.18);

}



/* =========================================================
   STATUS DOT
========================================================= */

.status-dot {

    position: absolute;

    right:
        -1px;

    bottom:
        1px;

    width:
        14px;

    height:
        14px;

    border-radius:
        50%;

    border:
        3px solid
        rgba(15,15,19,.96);

    background:
        #747f8d;

    box-shadow:
        0 0 8px
        rgba(0,0,0,.6);

}



/* =========================================================
   USER CONTENT
========================================================= */

.card-user-content {

    flex:
        1;

    min-width:
        0;

}


.card-user-row {

    display: flex;

    align-items: center;

    gap:
        8px;

    min-width:
        0;

}



/* =========================================================
   USERNAME
========================================================= */

.card-username {

    font-size:
        16px;

    font-weight:
        700;

    color:
        #ffffff;

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}



/* =========================================================
   TEK GÜZEL İKON

   Discord badge değil.
   Sadece tasarım ikonu.
========================================================= */

.profile-style-icon {

    position: relative;

    width:
        23px;

    height:
        23px;

    flex-shrink:
        0;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius:
        7px;

    font-size:
        11px;

    color:
        #c6b4ff;

    background:

        linear-gradient(
            145deg,
            rgba(154,125,255,.17),
            rgba(92,72,170,.07)
        );

    border:
        1px solid
        rgba(187,166,255,.20);

    box-shadow:

        inset 0 1px 0
        rgba(255,255,255,.06),

        0 0 10px
        rgba(151,122,255,.10);

    transition:
        transform .2s ease,
        box-shadow .2s ease;

}


.profile-style-icon:hover {

    transform:
        translateY(-1px)
        scale(1.07);

    box-shadow:

        inset 0 1px 0
        rgba(255,255,255,.08),

        0 0 14px
        rgba(151,122,255,.28);

}



/* =========================================================
   CUSTOM STATUS
========================================================= */

.card-status-text {

    display:
        block;

    margin-top:
        3px;

    font-size:
        12px;

    color:
        rgba(255,255,255,.62);

    font-style:
        italic;

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}



/* =========================================================
   ACTIVITY
========================================================= */

.activity-box {

    display:
        none;

    position:
        relative;

    overflow:
        hidden;

    margin-top:
        14px;

    padding:
        13px;

    border-radius:
        17px;

    background:

        linear-gradient(
            145deg,
            rgba(5,5,9,.42),
            rgba(25,25,32,.22)
        );

    border:
        1px solid
        rgba(255,255,255,.065);

    box-shadow:

        inset 0 1px 0
        rgba(255,255,255,.025);

}


.activity-box::after {

    content: '';

    position: absolute;

    left:
        -60px;

    top:
        -100px;

    width:
        180px;

    height:
        180px;

    pointer-events:
        none;

    background:

        radial-gradient(
            circle,
            rgba(151,131,255,.07),
            transparent 70%
        );

}



/* =========================================================
   ACTIVITY HEADER
========================================================= */

.activity-heading {

    position:
        relative;

    z-index:
        2;

    display: flex;

    align-items: center;

    justify-content:
        space-between;

    margin-bottom:
        10px;

}


.activity-header {

    font-size:
        10px;

    font-weight:
        700;

    letter-spacing:
        1px;

    color:
        rgba(255,255,255,.62);

    text-transform:
        uppercase;

}


.activity-live {

    display:
        flex;

    align-items:
        center;

    gap:
        5px;

    font-size:
        9px;

    color:
        rgba(255,255,255,.40);

}


.activity-live-dot {

    width:
        5px;

    height:
        5px;

    border-radius:
        50%;

    background:
        #b8a7ff;

    box-shadow:
        0 0 8px
        #b8a7ff;

    animation:
        livePulse
        1.5s
        ease-in-out
        infinite;

}


@keyframes livePulse {

    0%,
    100% {

        opacity:
            .4;

        transform:
            scale(.8);

    }


    50% {

        opacity:
            1;

        transform:
            scale(1.25);

    }

}



/* =========================================================
   ACTIVITY BODY
========================================================= */

.activity-main {

    position:
        relative;

    z-index:
        2;

    display:
        flex;

    align-items:
        center;

    gap:
        11px;

}



/* =========================================================
   ACTIVITY COVER
========================================================= */

.activity-cover {

    width:
        52px;

    height:
        52px;

    flex-shrink:
        0;

    overflow:
        hidden;

    border-radius:
        13px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    background:

        linear-gradient(
            145deg,
            rgba(30,30,38,.88),
            rgba(10,10,14,.95)
        );

    border:
        1px solid
        rgba(255,255,255,.07);

    color:
        rgba(255,255,255,.82);

    font-size:
        20px;

    box-shadow:
        0 5px 18px
        rgba(0,0,0,.20);

}


.activity-album {

    display:
        none;

    width:
        100%;

    height:
        100%;

    object-fit:
        cover;

}


.activity-fallback {

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

}



/* =========================================================
   ACTIVITY TEXT
========================================================= */

.activity-details {

    flex:
        1;

    min-width:
        0;

    display:
        flex;

    flex-direction:
        column;

}


.activity-title {

    font-size:
        13px;

    font-weight:
        700;

    color:
        rgba(255,255,255,.97);

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}


.activity-sub {

    margin-top:
        1px;

    font-size:
        11px;

    color:
        rgba(255,255,255,.55);

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}


.activity-state {

    margin-top:
        2px;

    font-size:
        10px;

    color:
        rgba(255,255,255,.36);

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}



/* =========================================================
   GAME TIME
========================================================= */

.progress-container {

    display:
        none;

    position:
        relative;

    z-index:
        3;

    align-items:
        center;

    width:
        100%;

    gap:
        9px;

    margin-top:
        12px;

}


.time-chip {

    min-width:
        60px;

    display:
        flex;

    align-items:
        center;

    gap:
        5px;

    font-size:
        10px;

    color:
        rgba(255,255,255,.60);

    white-space:
        nowrap;

}


.time-chip i {

    font-size:
        9px;

    color:
        #b7a5ff;

}



/* =========================================================
   SPOTIFY BAR
========================================================= */

.bar-bg {

    position:
        relative;

    flex:
        1;

    height:
        5px;

    min-width:
        50px;

    border-radius:
        999px;

    background:
        rgba(255,255,255,.07);

    box-shadow:
        inset 0 0 5px
        rgba(0,0,0,.20);

}


.bar-fill {

    position:
        relative;

    width:
        0%;

    height:
        100%;

    border-radius:
        inherit;

    background:

        linear-gradient(
            90deg,
            #947cff,
            #6e9eff,
            #c77dff,
            #ff8fd4
        );

    background-size:
        200% 100%;

    box-shadow:
        0 0 8px
        rgba(157,131,255,.45);

    transition:
        width .5s linear;

    animation:
        gradientMove
        3s
        linear
        infinite;

}


.bar-fill::after {

    content: '';

    position:
        absolute;

    top:
        50%;

    right:
        -3px;

    width:
        7px;

    height:
        7px;

    border-radius:
        50%;

    background:
        #ffffff;

    transform:
        translateY(-50%);

    box-shadow:

        0 0 5px
        #ffffff,

        0 0 10px
        rgba(183,163,255,.8);

}


@keyframes gradientMove {

    from {

        background-position:
            0% 50%;

    }

    to {

        background-position:
            200% 50%;

    }

}



/* =========================================================
   GAME SESSION LINE
========================================================= */

.game-session-line {

    position:
        relative;

    flex:
        1;

    height:
        5px;

    overflow:
        hidden;

    border-radius:
        999px;

    background:

        linear-gradient(
            90deg,
            rgba(255,255,255,.03),
            rgba(155,130,255,.09),
            rgba(255,255,255,.03)
        );

    box-shadow:

        inset 0 0 4px
        rgba(0,0,0,.30);

}


.game-session-line::before {

    content: '';

    position:
        absolute;

    inset:
        0;

    width:
        45%;

    background:

        linear-gradient(
            90deg,
            transparent,
            rgba(139,124,255,.25),
            rgba(115,183,255,.80),
            rgba(215,138,255,.72),
            transparent
        );

    animation:
        gameLine
        2.4s
        ease-in-out
        infinite;

}


.game-session-line::after {

    content: '';

    position:
        absolute;

    top:
        50%;

    width:
        6px;

    height:
        6px;

    border-radius:
        50%;

    background:
        #e4dcff;

    box-shadow:

        0 0 7px
        #b7a5ff,

        0 0 13px
        rgba(135,169,255,.65);

    transform:
        translateY(-50%);

    animation:
        gameDot
        2.4s
        ease-in-out
        infinite;

}


@keyframes gameLine {

    0% {

        transform:
            translateX(-120%);

    }


    100% {

        transform:
            translateX(330%);

    }

}


@keyframes gameDot {

    0% {

        left:
            -3%;

        opacity:
            .1;

    }


    15% {

        opacity:
            1;

    }


    85% {

        opacity:
            1;

    }


    100% {

        left:
            102%;

        opacity:
            .1;

    }

}


.activity-end-label {

    font-size:
        9px;

    color:
        rgba(255,255,255,.35);

    white-space:
        nowrap;

}



/* =========================================================
   SOCIALS
========================================================= */

.socials {

    display:
        flex;

    align-items:
        center;

    gap:
        18px;

    margin-top:
        6px;

}


.socials a {

    color:
        rgba(255,255,255,.88);

    text-decoration:
        none;

    font-size:
        21px;

    transition:

        transform .2s ease,

        color .2s ease,

        filter .2s ease;

}


.socials a:hover {

    transform:
        translateY(-2px)
        scale(1.08);

    color:
        #ffffff;

    filter:

        drop-shadow(
            0 0 7px
            rgba(255,255,255,.40)
        );

}



/* =========================================================
   MOBILE
========================================================= */

@media (
    max-width: 520px
) {

    body {

        padding:
            15px;

    }


    .discord-card {

        width:
            100%;

        max-width:
            390px;

    }


    .view-counter {

        top:
            12px;

        right:
            12px;

    }


    .audio-control {

        left:
            12px;

        bottom:
            12px;

    }


    .avatar-container {

        --avatar-size:
            106px;

        --decoration-size:
            116px;

        width:
            126px;

        height:
            126px;

    }


    .glow-username {

        font-size:
            31px;

    }

}


</style>

</head>



<body>



<!-- =====================================================
     ENTER
===================================================== -->

<div id="enterOverlay">

    <div class="enter-text">

        click to enter...

    </div>

</div>



<!-- =====================================================
     VIEW
===================================================== -->

<div class="view-counter">

    <i class="fa-regular fa-eye"></i>

    <span id="viewCountDisplay">

        <%= settings.viewCount %>

    </span>

</div>



<!-- =====================================================
     BACKGROUND
===================================================== -->

<video
    id="bgVideo"
    loop
    muted
    playsinline
    class="bg-video"
>

    <source
        src="/ssstik.io_@weall_loveasap_1788532602718.mp4"
        type="video/mp4"
    >

</video>



<!-- =====================================================
     AUDIO
===================================================== -->

<div class="audio-control">

    <button id="muteBtn">

        <i class="fa-solid fa-volume-high"></i>

    </button>


    <input
        type="range"
        id="volumeSlider"
        class="audio-slider"
        min="0"
        max="1"
        step="0.05"
        value="1"
    >

</div>



<!-- =====================================================
     BÜYÜK PP + KANAT
===================================================== -->

<div class="avatar-container">


    <img
        id="mainAvatar"
        class="main-avatar"
        src="<%= user.avatar_url || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
        alt="Avatar"
    >


    <img
        id="avatarFrame"
        class="avatar-frame"
        src="<%= user.avatar_decoration_url || '' %>"
        alt=""
        style="<%= user.avatar_decoration_url ? 'display:block;' : 'display:none;' %>"
        onerror="this.style.display='none'"
    >


</div>



<!-- =====================================================
     NAME
===================================================== -->

<div class="glow-username">

    <%= user.global_name || user.username %>

</div>



<!-- =====================================================
     BIO
===================================================== -->

<div class="bio-text">

    <%= settings.bioText %>

</div>



<!-- =====================================================
     DISCORD CARD
===================================================== -->

<div class="discord-card">


    <!-- USER TOP -->

    <div class="card-top">


        <!--
            KÜÇÜK PP

            Burada artık
            avatar decoration YOK.
        -->

        <div class="card-avatar-wrapper">


            <img
                id="cardAvatar"
                class="card-avatar"
                src="<%= user.avatar_url || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                alt="Avatar"
            >


            <div
                id="statusDot"
                class="status-dot"
            ></div>


        </div>



        <!-- USER INFO -->

        <div class="card-user-content">


            <div class="card-user-row">


                <span
                    id="cardUsername"
                    class="card-username"
                >

                    <%= user.username %>

                </span>



                <!--
                    TEK TASARIM İKONU
                -->

                <span
                    class="profile-style-icon"
                    title="Flozzy"
                >

                    <i class="fa-solid fa-gem"></i>

                </span>


            </div>



            <span
                id="customStatus"
                class="card-status-text"
            >

                Yükleniyor...

            </span>


        </div>


    </div>



    <!-- =================================================
         ACTIVITY
    ================================================= -->

    <div
        id="activityBox"
        class="activity-box"
    >


        <div class="activity-heading">


            <div
                id="activityHeader"
                class="activity-header"
            >

                OYNUYOR

            </div>



            <div class="activity-live">


                <div
                    class="activity-live-dot"
                ></div>


                <span>

                    Aktif

                </span>


            </div>


        </div>



        <!-- GAME INFO -->

        <div class="activity-main">


            <div class="activity-cover">


                <img
                    id="activityImg"
                    class="activity-album"
                    src=""
                    alt=""
                >


                <div
                    id="activityFallback"
                    class="activity-fallback"
                >

                    <i class="fa-solid fa-gamepad"></i>

                </div>


            </div>



            <div class="activity-details">


                <span
                    id="activityTitle"
                    class="activity-title"
                >

                    ...

                </span>



                <span
                    id="activitySub"
                    class="activity-sub"
                >

                    ...

                </span>



                <span
                    id="activityState"
                    class="activity-state"
                ></span>


            </div>


        </div>



        <!-- =================================================
             TIME
        ================================================= -->

        <div
            id="progressContainer"
            class="progress-container"
        >


            <span class="time-chip">


                <i class="fa-regular fa-clock"></i>


                <span id="currentTimeText">

                    0:00

                </span>


            </span>



            <!-- SPOTIFY -->

            <div
                id="spotifyBar"
                class="bar-bg"
                style="display:none;"
            >


                <div
                    id="barFill"
                    class="bar-fill"
                ></div>


            </div>



            <!-- GAME -->

            <div
                id="gameSessionLine"
                class="game-session-line"
                style="display:none;"
            ></div>



            <span
                id="totalTime"
                class="activity-end-label"
            >

                Aktif

            </span>


        </div>


    </div>


</div>



<!-- =====================================================
     SOCIAL
===================================================== -->

<div class="socials">


    <a
        href="https://discord.com/users/<%= user.id %>"
        target="_blank"
        title="Discord"
    >

        <i class="fa-brands fa-discord"></i>

    </a>


    <a
        href="https://tiktok.com"
        target="_blank"
        title="TikTok"
    >

        <i class="fa-brands fa-tiktok"></i>

    </a>


</div>



<script>


/* =========================================================
   USER
========================================================= */

const userId =
    "<%= user.id %>";


let currentTimer =
    null;



/* =========================================================
   TITLE
========================================================= */

let titleText =
    "Flozzy • ";


let titleIndex =
    0;


function marqueeTitle() {

    document.title =

        titleText.substring(
            titleIndex
        )

        +

        titleText.substring(
            0,
            titleIndex
        );


    titleIndex =

        (
            titleIndex + 1
        )

        %

        titleText.length;

}


setInterval(
    marqueeTitle,
    300
);



/* =========================================================
   VIEW COUNTER
========================================================= */

if (
    !localStorage.getItem(
        'flozzy_visited'
    )
) {

    localStorage.setItem(
        'flozzy_visited',
        'true'
    );


    fetch(
        '/api/increment-view',
        {
            method:
                'POST'
        }
    )

    .then(
        response =>
            response.json()
    )

    .then(data => {

        if (data.success) {

            document
                .getElementById(
                    'viewCountDisplay'
                )
                .innerText =
                    data.viewCount;

        }

    })

    .catch(error => {

        console.error(
            'Sayaç hatası:',
            error
        );

    });

}



/* =========================================================
   TIME FORMAT
========================================================= */

function formatTime(ms) {

    if (
        !Number.isFinite(ms)
        ||
        ms < 0
    ) {

        ms = 0;

    }


    const totalSeconds =
        Math.floor(
            ms / 1000
        );


    const hours =
        Math.floor(
            totalSeconds / 3600
        );


    const minutes =
        Math.floor(
            (
                totalSeconds % 3600
            )
            /
            60
        );


    const seconds =
        totalSeconds % 60;


    if (hours > 0) {

        return (

            `${hours}:`

            +

            `${minutes
                .toString()
                .padStart(2, '0')}:`

            +

            `${seconds
                .toString()
                .padStart(2, '0')}`

        );

    }


    return (

        `${minutes}:`

        +

        `${seconds
            .toString()
            .padStart(2, '0')}`

    );

}



/* =========================================================
   ACTIVITY IMAGE
========================================================= */

function setActivityImage(
    url,
    fallbackIcon =
        'fa-solid fa-gamepad'
) {

    const img =

        document.getElementById(
            'activityImg'
        );


    const fallback =

        document.getElementById(
            'activityFallback'
        );


    fallback.innerHTML =

        `<i class="${fallbackIcon}"></i>`;


    if (!url) {

        img.style.display =
            'none';


        fallback.style.display =
            'flex';


        img.removeAttribute(
            'src'
        );


        return;

    }


    img.onload =
        () => {


            img.style.display =
                'block';


            fallback.style.display =
                'none';


        };


    img.onerror =
        () => {


            img.style.display =
                'none';


            fallback.style.display =
                'flex';


        };


    img.src =
        url;

}



/* =========================================================
   ACTIVITY ASSET
========================================================= */

function resolveActivityAsset(
    activity
) {

    if (
        !activity
        ||
        !activity.assets
        ||
        !activity.assets.large_image
    ) {

        return null;

    }


    const image =
        activity.assets.large_image;



    /* DISCORD MEDIA */

    if (
        image.startsWith(
            'mp:'
        )
    ) {

        return (

            'https://media.discordapp.net/'

            +

            image.substring(3)

        );

    }



    /* SPOTIFY */

    if (
        image.startsWith(
            'spotify:'
        )
    ) {

        return (

            'https://i.scdn.co/image/'

            +

            image.substring(
                'spotify:'.length
            )

        );

    }



    /* APPLICATION ASSET */

    if (
        activity.application_id
    ) {

        return (

            `https://cdn.discordapp.com/app-assets/`

            +

            `${activity.application_id}/`

            +

            `${image}.png`

        );

    }


    return null;

}



/* =========================================================
   LANYARD
========================================================= */

async function fetchLanyard() {

    try {


        const response =

            await fetch(

                `https://api.lanyard.rest/v1/users/${userId}`

            );


        const result =

            await response.json();



        if (
            !result.success
            ||
            !result.data
        ) {

            return;

        }



        const l =
            result.data;


        const discordUser =
            l.discord_user;



        if (!discordUser) {

            return;

        }



        /* =================================================
           AVATAR
        ================================================= */

        let avatarUrl =

            'https://cdn.discordapp.com/embed/avatars/0.png';


        if (
            discordUser.avatar
        ) {

            const extension =

                discordUser.avatar
                    .startsWith('a_')

                    ?

                'gif'

                    :

                'png';


            avatarUrl =

                `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.${extension}?size=256`;

        }



        /*
            Büyük PP
        */

        document
            .getElementById(
                'mainAvatar'
            )
            .src =
                avatarUrl;



        /*
            Küçük PP

            Sadece normal avatar.
            Kanat YOK.
        */

        document
            .getElementById(
                'cardAvatar'
            )
            .src =
                avatarUrl;



        /* =================================================
           USERNAME
        ================================================= */

        document
            .getElementById(
                'cardUsername'
            )
            .innerText =

                discordUser.username

                ||

                'Discord User';



        /* =================================================
           SADECE BÜYÜK PP DECORATION
        ================================================= */

        const decoration =

            discordUser.avatar_decoration_data

            ||

            l.avatar_decoration_data;


        const avatarFrame =

            document.getElementById(
                'avatarFrame'
            );


        if (
            decoration
            &&
            decoration.asset
        ) {

            const decorationUrl =

                `https://cdn.discordapp.com/avatar-decoration-presets/${decoration.asset}.png?size=240&passthrough=true`;


            avatarFrame.src =
                decorationUrl;


            avatarFrame.style.display =
                'block';

        }

        else {

            avatarFrame.style.display =
                'none';

        }



        /* =================================================
           STATUS DOT
        ================================================= */

        const statusDot =

            document.getElementById(
                'statusDot'
            );


        const statusColors = {

            online:
                '#3ba55d',

            idle:
                '#faa81a',

            dnd:
                '#ed4245',

            offline:
                '#747f8d'

        };


        statusDot.style.backgroundColor =

            statusColors[
                l.discord_status
            ]

            ||

            '#747f8d';



        /* =================================================
           CUSTOM STATUS
        ================================================= */

        const custom =

            Array.isArray(
                l.activities
            )

            ?

            l.activities.find(
                activity =>
                    activity.type === 4
            )

            :

            null;


        const customStatus =

            document.getElementById(
                'customStatus'
            );


        if (
            custom
            &&
            custom.state
        ) {

            let text =
                custom.state;


            if (
                custom.emoji
                &&
                custom.emoji.name
            ) {

                text =

                    `${custom.emoji.name} ${text}`;

            }


            customStatus.innerText =
                text;

        }

        else {

            const prettyStatus = {

                online:
                    'online',

                idle:
                    'idle',

                dnd:
                    'dnd',

                offline:
                    'offline'

            };


            customStatus.innerText =

                prettyStatus[
                    l.discord_status
                ]

                ||

                'offline';

        }



        /* =================================================
           ACTIVITY ELEMENTS
        ================================================= */

        const activityBox =

            document.getElementById(
                'activityBox'
            );


        const activityHeader =

            document.getElementById(
                'activityHeader'
            );


        const activityTitle =

            document.getElementById(
                'activityTitle'
            );


        const activitySub =

            document.getElementById(
                'activitySub'
            );


        const activityState =

            document.getElementById(
                'activityState'
            );


        const progressContainer =

            document.getElementById(
                'progressContainer'
            );


        const currentTimeText =

            document.getElementById(
                'currentTimeText'
            );


        const totalTime =

            document.getElementById(
                'totalTime'
            );


        const spotifyBar =

            document.getElementById(
                'spotifyBar'
            );


        const gameSessionLine =

            document.getElementById(
                'gameSessionLine'
            );


        const barFill =

            document.getElementById(
                'barFill'
            );



        if (currentTimer) {

            clearInterval(
                currentTimer
            );


            currentTimer =
                null;

        }



        /* =================================================
           SPOTIFY
        ================================================= */

        if (
            l.listening_to_spotify
            &&
            l.spotify
        ) {

            activityBox.style.display =
                'block';


            activityHeader.innerText =
                'SPOTIFY DİNLİYOR';


            activityTitle.innerText =

                l.spotify.song

                ||

                'Spotify';


            activitySub.innerText =

                l.spotify.artist

                ||

                '';


            activityState.innerText =

                l.spotify.album

                ||

                '';


            setActivityImage(
                l.spotify.album_art_url,
                'fa-brands fa-spotify'
            );


            progressContainer.style.display =
                'flex';


            spotifyBar.style.display =
                'block';


            gameSessionLine.style.display =
                'none';


            totalTime.style.display =
                'block';



            const start =

                Number(
                    l.spotify.timestamps.start
                );


            const end =

                Number(
                    l.spotify.timestamps.end
                );


            const duration =

                Math.max(
                    end - start,
                    1
                );



            function spotifyTicker() {


                const elapsed =

                    Math.min(

                        Math.max(
                            Date.now() - start,
                            0
                        ),

                        duration

                    );


                const percentage =

                    (
                        elapsed
                        /
                        duration
                    )

                    *

                    100;


                currentTimeText.innerText =

                    formatTime(
                        elapsed
                    );


                totalTime.innerText =

                    formatTime(
                        duration
                    );


                barFill.style.width =

                    `${percentage}%`;

            }


            spotifyTicker();


            currentTimer =

                setInterval(
                    spotifyTicker,
                    1000
                );


            return;

        }



        /* =================================================
           GAME
        ================================================= */

        const game =

            Array.isArray(
                l.activities
            )

            ?

            l.activities.find(

                activity =>
                    activity.type === 0

            )

            :

            null;



        if (game) {


            activityBox.style.display =
                'block';


            activityHeader.innerText =
                'OYNUYOR';


            activityTitle.innerText =

                game.name

                ||

                'Oyun';



            /*
                Discord details veriyorsa
                onu göster.

                Yoksa:
                Playing Valorant
            */

            activitySub.innerText =

                game.details

                ||

                `Playing ${game.name}`;



            /*
                Örn:
                Capturing with Outplayed.tv
            */

            activityState.innerText =

                game.state
                &&
                game.state !== game.details

                ?

                game.state

                :

                '';



            const image =

                resolveActivityAsset(
                    game
                );


            setActivityImage(

                image,

                'fa-solid fa-gamepad'

            );



            /* =================================================
               GAME TIMER
            ================================================= */

            if (
                game.timestamps
                &&
                game.timestamps.start
            ) {


                progressContainer.style.display =
                    'flex';


                spotifyBar.style.display =
                    'none';


                gameSessionLine.style.display =
                    'block';


                totalTime.style.display =
                    'block';


                totalTime.innerText =
                    'Aktif';



                const startedAt =

                    Number(
                        game.timestamps.start
                    );



                function gameTicker() {


                    const elapsed =

                        Date.now()

                        -

                        startedAt;


                    currentTimeText.innerText =

                        formatTime(
                            elapsed
                        );


                }


                gameTicker();


                currentTimer =

                    setInterval(
                        gameTicker,
                        1000
                    );


            }

            else {


                progressContainer.style.display =
                    'flex';


                spotifyBar.style.display =
                    'none';


                gameSessionLine.style.display =
                    'block';


                currentTimeText.innerText =
                    'Aktif';


                totalTime.innerText =
                    'Oynuyor';


            }


            return;

        }



        /* =================================================
           NO ACTIVITY
        ================================================= */

        activityBox.style.display =
            'none';


    }

    catch (error) {


        console.error(
            'Lanyard hatası:',
            error
        );


    }

}



/* =========================================================
   START
========================================================= */

fetchLanyard();


setInterval(
    fetchLanyard,
    5000
);



/* =========================================================
   VIDEO / AUDIO
========================================================= */

const enterOverlay =

    document.getElementById(
        'enterOverlay'
    );


const bgVideo =

    document.getElementById(
        'bgVideo'
    );


const muteBtn =

    document.getElementById(
        'muteBtn'
    );


const volumeSlider =

    document.getElementById(
        'volumeSlider'
    );



/* =========================================================
   ENTER
========================================================= */

enterOverlay.addEventListener(
    'click',
    () => {


        enterOverlay.style.opacity =
            '0';


        setTimeout(
            () => {

                enterOverlay.style.display =
                    'none';

            },
            500
        );


        bgVideo.muted =
            false;


        bgVideo.volume =

            Number(
                volumeSlider.value
            );


        bgVideo
            .play()

            .catch(error => {

                console.log(
                    'Video oynatma hatası:',
                    error
                );

            });


    }
);



/* =========================================================
   VOLUME
========================================================= */

volumeSlider.addEventListener(
    'input',
    event => {


        const volume =

            Number(
                event.target.value
            );


        bgVideo.volume =
            volume;


        bgVideo.muted =
            volume === 0;


        updateVolumeIcon();


    }
);



/* =========================================================
   MUTE
========================================================= */

muteBtn.addEventListener(
    'click',
    () => {


        if (
            bgVideo.muted
            ||
            bgVideo.volume === 0
        ) {


            bgVideo.muted =
                false;


            let volume =

                Number(
                    volumeSlider.value
                );


            if (
                volume === 0
            ) {


                volume =
                    0.5;


                volumeSlider.value =
                    '0.5';


            }


            bgVideo.volume =
                volume;


        }

        else {


            bgVideo.muted =
                true;


        }


        updateVolumeIcon();


    }
);



/* =========================================================
   AUDIO ICON
========================================================= */

function updateVolumeIcon() {


    if (
        bgVideo.muted
        ||
        bgVideo.volume === 0
    ) {


        muteBtn.innerHTML =

            '<i class="fa-solid fa-volume-xmark"></i>';


        return;

    }



    if (
        bgVideo.volume < 0.5
    ) {


        muteBtn.innerHTML =

            '<i class="fa-solid fa-volume-low"></i>';


        return;

    }



    muteBtn.innerHTML =

        '<i class="fa-solid fa-volume-high"></i>';

}


</script>


</body>

</html>