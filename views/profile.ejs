<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="pageTitle">Flozzy</title>
    <link rel="icon" type="image/png" href="/ikon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body {
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            overflow: hidden;
            position: relative;
            background-color: #050505;
        }
        .bg-video {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100vw;
            min-height: 100vh;
            width: auto;
            height: auto;
            object-fit: cover;
            z-index: -2;
        }

        #enterOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(5, 5, 5, 0.92);
            backdrop-filter: blur(12px);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: opacity 0.5s ease;
        }
        .enter-text {
            font-size: 22px;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: 1px;
            animation: pulseText 1.5s infinite alternate;
        }
        @keyframes pulseText {
            0% { opacity: 0.4; }
            100% { opacity: 1; }
        }

        .avatar-container { 
            position: relative; 
            width: 170px; 
            height: 170px; 
            margin-bottom: 5px; 
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .main-avatar { 
            width: 110px; 
            height: 110px; 
            border-radius: 50%; 
            object-fit: cover; 
            position: absolute;
            z-index: 1; 
        }
        .avatar-frame {
            position: absolute;
            width: 170px;
            height: 170px;
            object-fit: contain;
            z-index: 2;
            pointer-events: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .glow-username { 
            font-size: 36px; 
            font-weight: 800; 
            color: #ffffff; 
            display: flex;
            align-items: center;
            gap: 10px;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.8), 0 0 30px rgba(255, 255, 255, 0.3); 
        }

        .bio-text { font-size: 14px; color: #cccccc; margin-bottom: 8px; text-align: center; max-width: 400px; padding: 0 15px; }

        .discord-card {
            background: rgba(18, 18, 22, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 20px;
            padding: 18px 22px;
            width: 390px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        }
        .card-top { display: flex; align-items: center; gap: 14px; }
        .card-avatar-wrapper { position: relative; width: 58px; height: 58px; flex-shrink: 0; }
        .card-avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background-color: #1a1a20; }
        .status-dot { width: 15px; height: 15px; border-radius: 50%; position: absolute; bottom: 0px; right: 0px; border: 3px solid #0f0f12; background-color: #747f8d; }
        .card-user-info { display: flex; flex-direction: column; }
        .card-username { font-size: 17px; font-weight: 700; color: #ffffff; }
        .card-status-text { font-size: 13px; color: #b0b0b0; font-style: italic; }

        .activity-box {
            display: none;
            background: rgba(18, 18, 22, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 14px;
            padding: 12px;
            flex-direction: column;
            gap: 8px;
        }
        .activity-header { font-size: 11px; font-weight: 700; color: #a0a0a5; letter-spacing: 0.5px; margin-bottom: 2px; }
        .activity-main { display: flex; align-items: center; gap: 12px; width: 100%; }
        .activity-album { width: 50px; height: 50px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
        .activity-details { display: flex; flex-direction: column; overflow: hidden; width: 100%; }
        .activity-title { font-size: 13px; font-weight: 700; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .activity-sub { font-size: 12px; color: #b3b3b3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        
        .progress-container { width: 100%; display: flex; align-items: center; gap: 8px; margin-top: 4px; }
        .time-text { font-size: 11px; color: #888888; font-family: monospace; white-space: nowrap; }
        .bar-bg { flex-grow: 1; height: 5px; background: rgba(255, 255, 255, 0.1); border-radius: 3px; overflow: hidden; }
        .bar-fill { height: 100%; background: #43b581; width: 0%; transition: width 0.3s linear; border-radius: 3px; }

        .socials { display: flex; gap: 20px; margin-top: 8px; }
        .socials a { color: #ffffff; font-size: 24px; text-decoration: none; filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.6)); transition: transform 0.2s; }
        .socials a:hover { transform: scale(1.15); }

        .view-counter {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(18, 18, 22, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            color: #fff;
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 13px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.5);
            z-index: 10;
        }
        .view-counter span:first-child {
            font-size: 9px;
            color: #999;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }
        .view-counter-inner {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 700;
        }
        .view-counter-inner i { color: #ccc; font-size: 12px; }

        .audio-control {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background: rgba(18, 18, 22, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            padding: 8px 14px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 10;
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }
        .audio-control button {
            background: none;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
        }
        .audio-slider {
            width: 70px;
            accent-color: #ffffff;
            cursor: pointer;
            height: 4px;
        }
    </style>
</head>
<body>

    <div id="enterOverlay">
        <div class="enter-text">click to enter...</div>
    </div>

    <div class="view-counter">
        <span>Profile Views</span>
        <div class="view-counter-inner">
            <i class="fa-solid fa-eye"></i>
            <span id="viewCountDisplay"><%= settings.viewCount %></span>
        </div>
    </div>

    <video id="bgVideo" loop muted playsinline class="bg-video">
        <source src="/ssstik.io_@weall_loveasap_1788532602718.mp4" type="video/mp4">
    </video>

    <div class="audio-control">
        <button id="muteBtn"><i class="fa-solid fa-volume-high"></i></button>
        <input type="range" id="volumeSlider" class="audio-slider" min="0" max="1" step="0.05" value="1">
    </div>

    <div class="avatar-container">
        <img id="mainAvatar" class="main-avatar" src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Avatar">
        <!-- Discord API'den gelen dinamik çerçeve görseli buraya basılacak -->
        <img id="avatarFrame" class="avatar-frame" src="" alt="" style="display: none;">
    </div>

    <div class="glow-username">
        <span><%= user.global_name || user.username %></span>
    </div>
    <div class="bio-text"><%= settings.bioText %></div>

    <div class="discord-card">
        <div class="card-top">
            <div class="card-avatar-wrapper">
                <img id="cardAvatar" class="card-avatar" src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Avatar">
                <div id="statusDot" class="status-dot"></div>
            </div>
            <div class="card-user-info">
                <span class="card-username"><%= user.username %></span>
                <span id="customStatus" class="card-status-text">Yükleniyor...</span>
            </div>
        </div>

        <div id="activityBox" class="activity-box">
            <div id="activityHeader" class="activity-header">Aktivite</div>
            <div class="activity-main">
                <img id="activityImg" class="activity-album" src="" alt="Art">
                <div class="activity-details">
                    <span id="activityTitle" class="activity-title">...</span>
                    <span id="activitySub" class="activity-sub">...</span>
                </div>
            </div>
            <div id="progressContainer" class="progress-container" style="display: none;">
                <span id="currentTime" class="time-text">0:00</span>
                <div class="bar-bg">
                    <div id="barFill" class="bar-fill"></div>
                </div>
                <span id="totalTime" class="time-text">Süre</span>
            </div>
        </div>
    </div>

    <div class="socials">
        <a href="https://discord.com/users/<%= user.id %>" target="_blank"><i class="fa-brands fa-discord"></i></a>
        <a href="https://tiktok.com" target="_blank"><i class="fa-brands fa-tiktok"></i></a>
    </div>

    <script>
        let titleText = "Flozzy • ";
        let titleIndex = 0;
        function marqueeTitle() {
            document.title = titleText.substring(titleIndex) + titleText.substring(0, titleIndex);
            titleIndex = (titleIndex + 1) % titleText.length;
        }
        setInterval(marqueeTitle, 300);

        const userId = "<%= user.id %>";
        let currentTimer = null;

        if (!localStorage.getItem('flozzy_visited')) {
            localStorage.setItem('flozzy_visited', 'true');
            fetch('/api/increment-view', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('viewCountDisplay').innerText = data.viewCount;
                    }
                }).catch(err => console.error("Sayaç hatası:", err));
        }

        function formatTime(ms) {
            const totalSeconds = Math.floor(ms / 1000);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
        }

        async function fetchLanyard() {
            try {
                const res = await fetch(`https://api.lanyard.rest/v1/users/${userId}`);
                const data = await res.json();

                if (data.success && data.data) {
                    const l = data.data;
                    const discordUser = l.discord_user;

                    if (discordUser && discordUser.avatar) {
                        const ext = discordUser.avatar.startsWith('a_') ? 'gif' : 'png';
                        const avatarUrl = `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.${ext}?size=256`;
                        document.getElementById('mainAvatar').src = avatarUrl;
                        document.getElementById('cardAvatar').src = avatarUrl;
                    }

                    // Discord Profil Çerçevesini (Avatar Decoration) Lanyard üzerinden yakalama
                    const avatarFrame = document.getElementById('avatarFrame');
                    if (discordUser && discordUser.avatar_decoration_data && discordUser.avatar_decoration_data.asset) {
                        const assetId = discordUser.avatar_decoration_data.asset;
                        const frameExt = assetId.startsWith('a_') ? 'gif' : 'png';
                        avatarFrame.src = `https://cdn.discordapp.com/avatar-decorations/${discordUser.id}/${assetId}.${frameExt}`;
                        avatarFrame.style.display = 'block';
                    } else {
                        avatarFrame.style.display = 'none';
                    }

                    const statusDot = document.getElementById('statusDot');
                    const colors = { online: '#43b581', idle: '#faa61a', dnd: '#f04747', offline: '#747f8d' };
                    statusDot.style.backgroundColor = colors[l.discord_status] || '#747f8d';

                    const customStatus = document.getElementById('customStatus');
                    const custom = l.activities ? l.activities.find(a => a.type === 4) : null;
                    customStatus.innerText = custom && custom.state ? custom.state : l.discord_status;

                    const actBox = document.getElementById('activityBox');
                    const actHeader = document.getElementById('activityHeader');
                    const actImg = document.getElementById('activityImg');
                    const actTitle = document.getElementById('activityTitle');
                    const actSub = document.getElementById('activitySub');
                    const progressContainer = document.getElementById('progressContainer');

                    if (currentTimer) clearInterval(currentTimer);

                    if (l.listening_to_spotify && l.spotify) {
                        actBox.style.display = 'flex';
                        actHeader.innerText = "SPOTIFY DİNLİYOR";
                        actImg.src = l.spotify.album_art_url;
                        actTitle.innerText = l.spotify.song;
                        actSub.innerText = l.spotify.artist;

                        progressContainer.style.display = 'flex';
                        const start = l.spotify.timestamps.start;
                        const end = l.spotify.timestamps.end;
                        const totalDuration = end - start;

                        const runTicker = () => {
                            const now = Date.now();
                            const elapsed = now - start;
                            const percentage = Math.min(Math.max((elapsed / totalDuration) * 100, 0), 100);
                            
                            document.getElementById('barFill').style.width = `${percentage}%`;
                            document.getElementById('currentTime').innerText = formatTime(Math.min(elapsed, totalDuration));
                            document.getElementById('totalTime').innerText = formatTime(totalDuration);
                        };

                        runTicker();
                        currentTimer = setInterval(runTicker, 1000);
                    } else if (l.activities && l.activities.find(a => a.type === 0)) {
                        const game = l.activities.find(a => a.type === 0);
                        actBox.style.display = 'flex';
                        actHeader.innerText = "OYNUYOR";
                        actTitle.innerText = game.name;
                        actSub.innerText = game.details || game.state || 'Oynuyor';

                        if (game.assets && game.assets.large_image) {
                            let largeImage = game.assets.large_image;
                            if (largeImage.startsWith('spotify:')) {
                                actImg.src = largeImage.replace('spotify:', 'https://i.scdn.co/image/');
                            } else if (largeImage.startsWith('mp:')) {
                                actImg.src = `https://media.discordapp.net/${largeImage.replace('mp:', '')}`;
                            } else {
                                actImg.src = `https://cdn.discordapp.com/app-assets/${game.application_id}/${largeImage}.png`;
                            }
                        } else {
                            actImg.src = 'https://cdn.discordapp.com/embed/avatars/0.png';
                        }

                        if (game.timestamps && game.timestamps.start) {
                            progressContainer.style.display = 'flex';
                            const start = game.timestamps.start;
                            document.getElementById('barFill').style.width = '100%';
                            document.getElementById('barFill').style.background = '#43b581';
                            document.getElementById('totalTime').innerText = "Süre";
                            
                            const runGameTicker = () => {
                                const elapsed = Date.now() - start;
                                document.getElementById('currentTime').innerText = formatTime(elapsed);
                            };
                            runGameTicker();
                            currentTimer = setInterval(runGameTicker, 1000);
                        } else {
                            progressContainer.style.display = 'none';
                        }
                    } else {
                        actBox.style.display = 'none';
                    }
                }
            } catch (err) {
                console.error("Lanyard hatası:", err);
            }
        }

        fetchLanyard();
        setInterval(fetchLanyard, 5000);

        const enterOverlay = document.getElementById('enterOverlay');
        const bgVideo = document.getElementById('bgVideo');
        const muteBtn = document.getElementById('muteBtn');
        const volumeSlider = document.getElementById('volumeSlider');

        enterOverlay.addEventListener('click', () => {
            enterOverlay.style.opacity = '0';
            setTimeout(() => { enterOverlay.style.display = 'none'; }, 500);

            bgVideo.muted = false;
            bgVideo.volume = volumeSlider.value;
            bgVideo.play().catch(e => console.log("Oynatma hatası:", e));
        });

        volumeSlider.addEventListener('input', (e) => {
            bgVideo.volume = e.target.value;
            bgVideo.muted = e.target.value == 0;
            updateVolumeIcon(bgVideo.volume);
        });

        muteBtn.addEventListener('click', () => {
            if (bgVideo.muted || bgVideo.volume == 0) {
                bgVideo.muted = false;
                bgVideo.volume = volumeSlider.value > 0 ? volumeSlider.value : 0.5;
                volumeSlider.value = bgVideo.volume;
            } else {
                bgVideo.muted = true;
                bgVideo.volume = 0;
                volumeSlider.value = 0;
            }
            updateVolumeIcon(bgVideo.volume);
        });

        function updateVolumeIcon(vol) {
            if (vol == 0 || bgVideo.muted) {
                muteBtn.innerHTML = '<i class="fa-solid fa-volume-xmark"></i>';
            } else if (vol < 0.5) {
                muteBtn.innerHTML = '<i class="fa-solid fa-volume-low"></i>';
            } else {
                muteBtn.innerHTML = '<i class="fa-solid fa-volume-high"></i>';
            }
        }
    </script>
</body>
</html>