<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Flozzy</title>


    <link
        rel="icon"
        type="image/png"
        href="/ikon.png"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >


    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >



<style>


/* =========================================================
   RESET
========================================================= */

* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

    font-family:
        'Poppins',
        sans-serif;

}


html,
body {

    width: 100%;

    min-height: 100%;

}


body {

    min-height: 100vh;

    color: #ffffff;

    background:
        #050505;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 10px;

    position: relative;

    overflow: hidden;

}



/* =========================================================
   DARK BACKGROUND OVERLAY
========================================================= */

body::after {

    content: '';

    position: fixed;

    inset: 0;

    pointer-events: none;

    z-index: -1;

    background:

        radial-gradient(
            circle at 50% 35%,
            rgba(255,255,255,0.03),
            transparent 35%
        ),

        linear-gradient(
            180deg,
            rgba(0,0,0,0.03),
            rgba(0,0,0,0.24)
        );

}



/* =========================================================
   BACKGROUND VIDEO
========================================================= */

.bg-video {

    position: fixed;

    top: 50%;

    left: 50%;

    transform:
        translate(-50%, -50%);

    min-width: 100vw;

    min-height: 100vh;

    width: auto;

    height: auto;

    object-fit: cover;

    z-index: -3;

}



/* =========================================================
   ENTER SCREEN
========================================================= */

#enterOverlay {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100vh;

    background:
        rgba(5,5,5,0.90);

    backdrop-filter:
        blur(15px);

    -webkit-backdrop-filter:
        blur(15px);

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    transition:
        opacity .5s ease;

}


.enter-text {

    font-size: 20px;

    font-weight: 600;

    color:
        rgba(255,255,255,.92);

    letter-spacing: 1px;

    animation:
        enterPulse 1.3s ease-in-out infinite alternate;

}


@keyframes enterPulse {

    from {

        opacity: .35;

        transform:
            scale(.98);

    }

    to {

        opacity: 1;

        transform:
            scale(1);

    }

}



/* =========================================================
   VIEW COUNTER
========================================================= */

.view-counter {

    position: fixed;

    right: 20px;

    top: 20px;

    z-index: 50;

    padding:
        8px 14px;

    border-radius: 15px;

    border:
        1px solid rgba(255,255,255,.10);

    background:
        rgba(10,10,14,.35);

    backdrop-filter:
        blur(16px);

    -webkit-backdrop-filter:
        blur(16px);

    box-shadow:
        0 10px 30px
        rgba(0,0,0,.25);

    display: flex;

    align-items: center;

    gap: 7px;

    font-size: 12px;

    color:
        rgba(255,255,255,.75);

}


.view-counter i {

    color:
        rgba(255,255,255,.65);

}



/* =========================================================
   AUDIO
========================================================= */

.audio-control {

    position: fixed;

    bottom: 20px;

    left: 20px;

    z-index: 50;

    display: flex;

    align-items: center;

    gap: 8px;

    padding:
        8px 12px;

    border-radius: 16px;

    background:
        rgba(8,8,12,.35);

    border:
        1px solid rgba(255,255,255,.09);

    backdrop-filter:
        blur(16px);

    -webkit-backdrop-filter:
        blur(16px);

}


.audio-control button {

    border: 0;

    background: none;

    color: white;

    cursor: pointer;

    width: 25px;

}


.audio-slider {

    width: 75px;

    height: 3px;

    cursor: pointer;

    accent-color:
        #c5b9ff;

}



/* =========================================================
   MAIN AVATAR
========================================================= */

.avatar-container {

    /*
        Profil fotoğrafı
    */

    --avatar-size:
        110px;


    /*
        Discord decoration.

        Kanatlı decoration için
        bu değer güzel oturuyor.
    */

    --decoration-size:
        138px;


    position: relative;

    width: 150px;

    height: 150px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

}


.main-avatar {

    position: absolute;

    top: 50%;

    left: 50%;

    width:
        var(--avatar-size);

    height:
        var(--avatar-size);

    transform:
        translate(-50%, -50%);

    border-radius: 50%;

    object-fit: cover;

    z-index: 1;

    box-shadow:

        0 0 0 1px
        rgba(255,255,255,.10),

        0 15px 40px
        rgba(0,0,0,.25);

}


.avatar-frame {

    position: absolute;

    top: 50%;

    left: 50%;

    width:
        var(--decoration-size);

    height:
        var(--decoration-size);

    transform:
        translate(-50%, -50%);

    object-fit: contain;

    pointer-events: none;

    z-index: 2;

    display: none;

}



/* =========================================================
   MAIN USERNAME
========================================================= */

.glow-username {

    font-size: 34px;

    line-height: 1;

    font-weight: 800;

    margin-top: 0px;

    text-shadow:

        0 0 12px
        rgba(255,255,255,.68),

        0 0 30px
        rgba(255,255,255,.20);

}


.bio-text {

    font-size: 13px;

    color:
        rgba(255,255,255,.74);

    text-align: center;

    max-width: 410px;

    padding:
        0 12px;

    margin:
        5px 0 7px;

}



/* =========================================================
   DISCORD CARD
========================================================= */

.discord-card {

    width: 390px;

    max-width:
        calc(100vw - 30px);


    /*
        Öncekinden daha saydam.
    */

    background:

        linear-gradient(
            135deg,
            rgba(10,10,14,.36),
            rgba(35,35,42,.22)
        );


    border:
        1px solid
        rgba(255,255,255,.10);


    backdrop-filter:
        blur(18px)
        saturate(125%);


    -webkit-backdrop-filter:
        blur(18px)
        saturate(125%);


    border-radius: 22px;


    padding:
        17px;


    box-shadow:

        0 18px 50px
        rgba(0,0,0,.32),

        inset 0 1px 0
        rgba(255,255,255,.04);


    position: relative;

    overflow: hidden;

}



/* light glare */

.discord-card::before {

    content: '';

    position: absolute;

    width: 190px;

    height: 190px;

    right: -80px;

    top: -100px;

    pointer-events: none;

    background:

        radial-gradient(
            circle,
            rgba(255,255,255,.10),
            transparent 67%
        );

}



/* =========================================================
   DISCORD CARD TOP
========================================================= */

.card-top {

    display: flex;

    align-items: center;

    gap: 13px;

    position: relative;

    z-index: 2;

}


.card-avatar-wrapper {

    position: relative;

    width: 60px;

    height: 60px;

    flex-shrink: 0;

}


.card-avatar {

    width: 100%;

    height: 100%;

    border-radius: 50%;

    object-fit: cover;

    border:
        1px solid
        rgba(255,255,255,.08);

}


.status-dot {

    position: absolute;

    bottom: 1px;

    right: 0px;

    width: 14px;

    height: 14px;

    border-radius: 50%;

    border:
        3px solid
        rgba(17,17,21,.95);

    background:
        #747f8d;

    box-shadow:
        0 0 8px
        rgba(0,0,0,.5);

}


.card-user-content {

    min-width: 0;

    flex: 1;

}


.card-user-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.card-username {

    font-size: 16px;

    font-weight: 700;

    color: #fff;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

}


.card-status-text {

    margin-top: 1px;

    font-size: 12px;

    color:
        rgba(255,255,255,.55);

    font-style: italic;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

}



/* =========================================================
   DISCORD BADGES
========================================================= */

.discord-badges {

    margin-top: 7px;

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 5px;

}


.discord-badges:empty {

    display: none;

}


.discord-badge {

    --badge-color:
        #c7c7ff;


    width: 22px;

    height: 22px;

    position: relative;

    border-radius: 7px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    color:
        var(--badge-color);

    background:

        linear-gradient(
            145deg,
            rgba(255,255,255,.095),
            rgba(255,255,255,.025)
        );

    border:

        1px solid
        color-mix(
            in srgb,
            var(--badge-color) 28%,
            transparent
        );


    box-shadow:

        inset 0 1px 0
        rgba(255,255,255,.07),

        0 3px 10px
        rgba(0,0,0,.13);


    font-size: 11px;


    transition:

        transform .18s ease,

        background .18s ease;

}


.discord-badge:hover {

    transform:
        translateY(-2px)
        scale(1.06);

    background:
        rgba(255,255,255,.10);

}


.discord-badge::after {

    content:
        attr(data-name);

    position: absolute;

    left: 50%;

    bottom:
        calc(100% + 7px);

    transform:
        translateX(-50%);

    white-space: nowrap;

    pointer-events: none;

    opacity: 0;

    visibility: hidden;

    font-size: 10px;

    color: #fff;

    padding:
        5px 8px;

    border-radius: 7px;

    background:
        rgba(10,10,13,.96);

    border:
        1px solid
        rgba(255,255,255,.08);

    transition:
        opacity .15s ease;

}


.discord-badge:hover::after {

    opacity: 1;

    visibility: visible;

}



/* =========================================================
   ACTIVITY
========================================================= */

.activity-box {

    display: none;

    margin-top: 14px;

    padding: 13px;

    border-radius: 17px;


    /*
        İç kart da daha saydam.
    */

    background:

        linear-gradient(
            145deg,
            rgba(7,7,11,.42),
            rgba(25,25,32,.27)
        );


    border:
        1px solid
        rgba(255,255,255,.07);


    box-shadow:

        inset 0 1px 0
        rgba(255,255,255,.025);


    position: relative;

    overflow: hidden;

}


.activity-box::after {

    content: '';

    position: absolute;

    left: -60px;

    top: -100px;

    width: 180px;

    height: 180px;

    pointer-events: none;

    background:

        radial-gradient(
            circle,
            rgba(151,131,255,.07),
            transparent 70%
        );

}



/* activity heading */

.activity-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    position: relative;

    z-index: 2;

    margin-bottom: 10px;

}


.activity-header {

    font-size: 10px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 1px;

    color:
        rgba(255,255,255,.62);

}


.activity-live {

    display: flex;

    align-items: center;

    gap: 5px;

    font-size: 9px;

    color:
        rgba(255,255,255,.43);

}


.activity-live-dot {

    width: 5px;

    height: 5px;

    border-radius: 50%;

    background:
        #b8a7ff;

    box-shadow:
        0 0 8px
        #b8a7ff;

    animation:
        livePulse 1.5s ease-in-out infinite;

}


@keyframes livePulse {

    0%,
    100% {

        opacity: .4;

        transform:
            scale(.8);

    }

    50% {

        opacity: 1;

        transform:
            scale(1.25);

    }

}



/* =========================================================
   ACTIVITY BODY
========================================================= */

.activity-main {

    display: flex;

    align-items: center;

    gap: 11px;

    position: relative;

    z-index: 2;

}


.activity-cover {

    width: 51px;

    height: 51px;

    flex-shrink: 0;

    border-radius: 13px;

    overflow: hidden;

    background:

        linear-gradient(
            145deg,
            rgba(30,30,38,.9),
            rgba(12,12,16,.95)
        );

    border:
        1px solid
        rgba(255,255,255,.07);

    display: flex;

    align-items: center;

    justify-content: center;

    color:
        rgba(255,255,255,.80);

    font-size: 20px;

    box-shadow:
        0 5px 18px
        rgba(0,0,0,.18);

}


.activity-album {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: none;

}


.activity-fallback {

    display: flex;

    align-items: center;

    justify-content: center;

}


.activity-details {

    flex: 1;

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.activity-title {

    font-size: 13px;

    font-weight: 700;

    color:
        rgba(255,255,255,.97);

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.activity-sub {

    margin-top: 1px;

    font-size: 11px;

    color:
        rgba(255,255,255,.53);

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.activity-state {

    margin-top: 2px;

    font-size: 10px;

    color:
        rgba(255,255,255,.36);

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   ACTIVITY TIME AREA
========================================================= */

.progress-container {

    display: none;

    align-items: center;

    gap: 9px;

    width: 100%;

    margin-top: 12px;

    position: relative;

    z-index: 3;

}


.time-chip {

    min-width: 53px;

    display: flex;

    align-items: center;

    gap: 5px;

    font-size: 10px;

    color:
        rgba(255,255,255,.57);

    white-space: nowrap;

}


.time-chip i {

    font-size: 9px;

    color:
        #b7a5ff;

}



/* =========================================================
   NEW BEAUTIFUL PROGRESS
========================================================= */

.bar-bg {

    position: relative;

    flex: 1;

    height: 5px;

    min-width: 50px;

    overflow: hidden;

    border-radius: 999px;

    background:
        rgba(255,255,255,.075);

    box-shadow:
        inset 0 0 5px
        rgba(0,0,0,.20);

}


.bar-fill {

    position: relative;

    width: 0%;

    height: 100%;

    border-radius: inherit;

    background:

        linear-gradient(
            90deg,
            #947cff,
            #6e9eff,
            #c77dff,
            #ff8fd4
        );

    background-size:
        200% 100%;

    box-shadow:

        0 0 8px
        rgba(157,131,255,.45);

    transition:
        width .5s linear;

    animation:
        gradientMove 3s linear infinite;

}


.bar-fill::after {

    content: '';

    position: absolute;

    right: -2px;

    top: 50%;

    width: 7px;

    height: 7px;

    transform:
        translateY(-50%);

    border-radius: 50%;

    background:
        #ffffff;

    box-shadow:

        0 0 5px #fff,

        0 0 10px
        rgba(183,163,255,.8);

}


@keyframes gradientMove {

    from {

        background-position:
            0% 50%;

    }

    to {

        background-position:
            200% 50%;

    }

}



/* =========================================================
   GAME SESSION LINE
========================================================= */

.game-session-line {

    position: relative;

    flex: 1;

    height: 5px;

    border-radius: 999px;

    overflow: hidden;

    background:
        rgba(255,255,255,.06);

}


.game-session-line::before {

    content: '';

    position: absolute;

    inset: 0;

    width: 45%;

    background:

        linear-gradient(
            90deg,
            transparent,
            rgba(139,124,255,.28),
            rgba(115,183,255,.76),
            rgba(215,138,255,.70),
            transparent
        );

    filter:
        blur(.2px);

    animation:
        gameLine 2.3s ease-in-out infinite;

}


.game-session-line::after {

    content: '';

    position: absolute;

    top: 50%;

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: #d8ceff;

    box-shadow:

        0 0 7px
        #b7a5ff,

        0 0 12px
        rgba(135,169,255,.50);

    transform:
        translateY(-50%);

    animation:
        gameDot 2.3s ease-in-out infinite;

}


@keyframes gameLine {

    0% {

        transform:
            translateX(-120%);

    }

    100% {

        transform:
            translateX(330%);

    }

}


@keyframes gameDot {

    0% {

        left: -3%;

        opacity: .1;

    }

    15% {

        opacity: 1;

    }

    85% {

        opacity: 1;

    }

    100% {

        left: 102%;

        opacity: .1;

    }

}


.activity-end-label {

    font-size: 9px;

    color:
        rgba(255,255,255,.35);

    white-space: nowrap;

}



/* =========================================================
   SOCIALS
========================================================= */

.socials {

    display: flex;

    align-items: center;

    gap: 18px;

    margin-top: 5px;

}


.socials a {

    color:
        rgba(255,255,255,.88);

    text-decoration: none;

    font-size: 21px;

    transition:

        transform .2s ease,

        color .2s ease,

        filter .2s ease;

}


.socials a:hover {

    transform:
        translateY(-2px)
        scale(1.08);

    color: #fff;

    filter:
        drop-shadow(
            0 0 7px
            rgba(255,255,255,.40)
        );

}



/* =========================================================
   MOBILE
========================================================= */

@media (
    max-width: 520px
) {

    body {

        justify-content: center;

        padding:
            15px;

    }


    .discord-card {

        width: 100%;

        max-width: 390px;

    }


    .view-counter {

        right: 12px;

        top: 12px;

    }


    .audio-control {

        bottom: 12px;

        left: 12px;

    }


    .avatar-container {

        --avatar-size:
            108px;

        --decoration-size:
            135px;

    }


    .glow-username {

        font-size:
            31px;

    }

}


</style>

</head>



<body>



<!-- =====================================================
     CLICK TO ENTER
===================================================== -->

<div id="enterOverlay">

    <div class="enter-text">

        click to enter...

    </div>

</div>



<!-- =====================================================
     PROFILE VIEWS
===================================================== -->

<div class="view-counter">

    <i class="fa-regular fa-eye"></i>

    <span id="viewCountDisplay">

        <%= settings.viewCount %>

    </span>

</div>



<!-- =====================================================
     BACKGROUND VIDEO
===================================================== -->

<video
    id="bgVideo"
    loop
    muted
    playsinline
    class="bg-video"
>

    <source
        src="/ssstik.io_@weall_loveasap_1788532602718.mp4"
        type="video/mp4"
    >

</video>



<!-- =====================================================
     AUDIO
===================================================== -->

<div class="audio-control">

    <button id="muteBtn">

        <i class="fa-solid fa-volume-high"></i>

    </button>


    <input
        type="range"
        id="volumeSlider"
        class="audio-slider"
        min="0"
        max="1"
        step="0.05"
        value="1"
    >

</div>



<!-- =====================================================
     MAIN AVATAR
===================================================== -->

<div class="avatar-container">


    <img
        id="mainAvatar"
        class="main-avatar"
        src="<%= user.avatar_url || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
        alt="Avatar"
    >


    <img
        id="avatarFrame"
        class="avatar-frame"
        src="<%= user.avatar_decoration_url || '' %>"
        alt=""
        style="<%= user.avatar_decoration_url ? 'display:block;' : 'display:none;' %>"
        onerror="this.style.display='none'"
    >


</div>



<!-- =====================================================
     MAIN NAME
===================================================== -->

<div class="glow-username">

    <%= user.global_name || user.username %>

</div>



<!-- =====================================================
     BIO
===================================================== -->

<div class="bio-text">

    <%= settings.bioText %>

</div>



<!-- =====================================================
     DISCORD CARD
===================================================== -->

<div class="discord-card">


    <!-- TOP -->

    <div class="card-top">


        <div class="card-avatar-wrapper">


            <img
                id="cardAvatar"
                class="card-avatar"
                src="<%= user.avatar_url || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                alt="Avatar"
            >


            <div
                id="statusDot"
                class="status-dot"
            ></div>


        </div>



        <div class="card-user-content">


            <div class="card-user-info">


                <span
                    id="cardUsername"
                    class="card-username"
                >

                    <%= user.username %>

                </span>


                <span
                    id="customStatus"
                    class="card-status-text"
                >

                    Yükleniyor...

                </span>


            </div>



            <!-- DISCORD BADGES -->

            <div
                id="discordBadges"
                class="discord-badges"
            ></div>


        </div>


    </div>



    <!-- =================================================
         ACTIVITY
    ================================================= -->

    <div
        id="activityBox"
        class="activity-box"
    >


        <div class="activity-heading">


            <div
                id="activityHeader"
                class="activity-header"
            >

                OYNUYOR

            </div>


            <div class="activity-live">

                <div
                    class="activity-live-dot"
                ></div>

                <span id="activityLiveText">

                    Aktif

                </span>

            </div>


        </div>



        <div class="activity-main">


            <!-- COVER -->

            <div class="activity-cover">


                <img
                    id="activityImg"
                    class="activity-album"
                    src=""
                    alt=""
                >


                <div
                    id="activityFallback"
                    class="activity-fallback"
                >

                    <i class="fa-solid fa-gamepad"></i>

                </div>


            </div>



            <!-- TEXT -->

            <div class="activity-details">


                <span
                    id="activityTitle"
                    class="activity-title"
                >

                    ...

                </span>


                <span
                    id="activitySub"
                    class="activity-sub"
                >

                    ...

                </span>


                <span
                    id="activityState"
                    class="activity-state"
                ></span>


            </div>


        </div>



        <!-- PROGRESS / SESSION -->

        <div
            id="progressContainer"
            class="progress-container"
        >


            <span
                id="currentTime"
                class="time-chip"
            >

                <i class="fa-regular fa-clock"></i>

                <span id="currentTimeText">

                    0:00

                </span>

            </span>



            <!-- SPOTIFY BAR -->

            <div
                id="spotifyBar"
                class="bar-bg"
                style="display:none;"
            >

                <div
                    id="barFill"
                    class="bar-fill"
                ></div>

            </div>



            <!-- GAME ANIMATION -->

            <div
                id="gameSessionLine"
                class="game-session-line"
                style="display:none;"
            ></div>



            <span
                id="totalTime"
                class="activity-end-label"
            >

                Süre

            </span>


        </div>


    </div>


</div>



<!-- =====================================================
     SOCIALS
===================================================== -->

<div class="socials">


    <a
        href="https://discord.com/users/<%= user.id %>"
        target="_blank"
        title="Discord"
    >

        <i class="fa-brands fa-discord"></i>

    </a>


    <a
        href="https://tiktok.com"
        target="_blank"
        title="TikTok"
    >

        <i class="fa-brands fa-tiktok"></i>

    </a>


</div>



<script>


/* =========================================================
   USER ID
========================================================= */

const userId =
    "<%= user.id %>";



/* =========================================================
   TITLE ANIMATION
========================================================= */

let titleText =
    "Flozzy • ";


let titleIndex =
    0;


function marqueeTitle() {

    document.title =

        titleText.substring(
            titleIndex
        )

        +

        titleText.substring(
            0,
            titleIndex
        );


    titleIndex =

        (
            titleIndex + 1
        )

        %

        titleText.length;

}


setInterval(
    marqueeTitle,
    300
);



/* =========================================================
   VIEW COUNTER
========================================================= */

if (
    !localStorage.getItem(
        'flozzy_visited'
    )
) {

    localStorage.setItem(
        'flozzy_visited',
        'true'
    );


    fetch(
        '/api/increment-view',
        {
            method:
                'POST'
        }
    )

    .then(
        response =>
            response.json()
    )

    .then(data => {

        if (data.success) {

            document
                .getElementById(
                    'viewCountDisplay'
                )
                .innerText =
                    data.viewCount;

        }

    })

    .catch(error => {

        console.error(
            'Sayaç hatası:',
            error
        );

    });

}



/* =========================================================
   TIME FORMAT
========================================================= */

function formatTime(ms) {

    if (
        !Number.isFinite(ms) ||
        ms < 0
    ) {

        ms = 0;

    }


    const totalSeconds =
        Math.floor(
            ms / 1000
        );


    const hours =
        Math.floor(
            totalSeconds / 3600
        );


    const minutes =
        Math.floor(
            (
                totalSeconds % 3600
            )
            / 60
        );


    const seconds =
        totalSeconds % 60;


    if (hours > 0) {

        return (

            `${hours}:`

            +

            `${minutes
                .toString()
                .padStart(2, '0')}:`

            +

            `${seconds
                .toString()
                .padStart(2, '0')}`

        );

    }


    return (

        `${minutes}:`

        +

        `${seconds
            .toString()
            .padStart(2, '0')}`

    );

}



/* =========================================================
   DISCORD BADGES
========================================================= */

/*
    Discord public_flags.

    Nitro gibi bazı profil rozetleri
    public_flags içinde bulunmaz.

    Bu yüzden API'den gerçekten gelen
    rozetleri gösteriyoruz.
*/

const badgeDefinitions = [

    {

        bit: 1 << 0,

        name:
            'Discord Staff',

        icon:
            'fa-solid fa-hammer',

        color:
            '#ff6c75'

    },


    {

        bit: 1 << 1,

        name:
            'Partner',

        icon:
            'fa-solid fa-handshake',

        color:
            '#8ea1e1'

    },


    {

        bit: 1 << 2,

        name:
            'HypeSquad Events',

        icon:
            'fa-solid fa-bolt',

        color:
            '#f47fff'

    },


    {

        bit: 1 << 3,

        name:
            'Bug Hunter',

        icon:
            'fa-solid fa-bug',

        color:
            '#56d89c'

    },


    {

        bit: 1 << 6,

        name:
            'HypeSquad Bravery',

        icon:
            'fa-solid fa-diamond',

        color:
            '#9c84ff'

    },


    {

        bit: 1 << 7,

        name:
            'HypeSquad Brilliance',

        icon:
            'fa-solid fa-gem',

        color:
            '#f47fff'

    },


    {

        bit: 1 << 8,

        name:
            'HypeSquad Balance',

        icon:
            'fa-solid fa-scale-balanced',

        color:
            '#45c6b8'

    },


    {

        bit: 1 << 9,

        name:
            'Early Supporter',

        icon:
            'fa-solid fa-heart',

        color:
            '#f3a45c'

    },


    {

        bit: 1 << 14,

        name:
            'Bug Hunter Gold',

        icon:
            'fa-solid fa-bug',

        color:
            '#f6c453'

    },


    {

        bit: 1 << 17,

        name:
            'Early Verified Bot Developer',

        icon:
            'fa-solid fa-code',

        color:
            '#7289da'

    },


    {

        bit: 1 << 18,

        name:
            'Discord Moderator',

        icon:
            'fa-solid fa-shield-halved',

        color:
            '#64d6c4'

    },


    {

        bit: 1 << 22,

        name:
            'Active Developer',

        icon:
            'fa-solid fa-terminal',

        color:
            '#697cff'

    }

];



function renderBadges(
    publicFlags,
    hasDecoration
) {

    const holder =

        document.getElementById(
            'discordBadges'
        );


    holder.innerHTML =
        '';


    publicFlags =
        Number(
            publicFlags || 0
        );


    badgeDefinitions
        .forEach(badge => {

            if (
                (
                    publicFlags &
                    badge.bit
                )
                !== 0
            ) {

                const element =
                    document.createElement(
                        'span'
                    );


                element.className =
                    'discord-badge';


                element.dataset.name =
                    badge.name;


                element.style
                    .setProperty(
                        '--badge-color',
                        badge.color
                    );


                element.innerHTML =
                    `<i class="${badge.icon}"></i>`;


                holder.appendChild(
                    element
                );

            }

        });



    /*
        Avatar decoration varsa
        küçük kozmetik rozeti.
    */

    if (hasDecoration) {

        const decorationBadge =
            document.createElement(
                'span'
            );


        decorationBadge.className =
            'discord-badge';


        decorationBadge.dataset.name =
            'Avatar Decoration';


        decorationBadge.style
            .setProperty(
                '--badge-color',
                '#c9a6ff'
            );


        decorationBadge.innerHTML =

            '<i class="fa-solid fa-wand-magic-sparkles"></i>';


        holder.appendChild(
            decorationBadge
        );

    }

}



/* =========================================================
   ACTIVITY IMAGE
========================================================= */

function setActivityImage(
    url,
    fallbackIcon = 'fa-solid fa-gamepad'
) {

    const img =

        document.getElementById(
            'activityImg'
        );


    const fallback =

        document.getElementById(
            'activityFallback'
        );


    fallback.innerHTML =

        `<i class="${fallbackIcon}"></i>`;


    if (!url) {

        img.style.display =
            'none';


        fallback.style.display =
            'flex';


        img.removeAttribute(
            'src'
        );


        return;
    }


    img.onload =
        () => {

            img.style.display =
                'block';


            fallback.style.display =
                'none';

        };


    img.onerror =
        () => {

            img.style.display =
                'none';


            fallback.style.display =
                'flex';

        };


    img.src =
        url;

}



/* =========================================================
   ACTIVITY ASSET RESOLVER
========================================================= */

function resolveActivityAsset(
    activity
) {

    if (
        !activity ||
        !activity.assets ||
        !activity.assets.large_image
    ) {

        return null;

    }


    const image =
        activity.assets.large_image;


    /*
        mp:
    */

    if (
        image.startsWith(
            'mp:'
        )
    ) {

        return (

            'https://media.discordapp.net/'

            +

            image.substring(3)

        );

    }


    /*
        spotify:
    */

    if (
        image.startsWith(
            'spotify:'
        )
    ) {

        return (

            'https://i.scdn.co/image/'

            +

            image.substring(
                'spotify:'.length
            )

        );

    }


    /*
        application asset
    */

    if (
        activity.application_id
    ) {

        return (

            `https://cdn.discordapp.com/app-assets/`

            +

            `${activity.application_id}/`

            +

            `${image}.png`

        );

    }


    return null;

}



/* =========================================================
   LANYARD
========================================================= */

let currentTimer =
    null;



async function fetchLanyard() {

    try {

        const response =
            await fetch(

                `https://api.lanyard.rest/v1/users/${userId}`

            );


        const result =
            await response.json();


        if (
            !result.success ||
            !result.data
        ) {

            return;

        }


        const l =
            result.data;


        const discordUser =
            l.discord_user;



        if (!discordUser) {

            return;

        }



        /* =================================================
           AVATAR
        ================================================= */

        let avatarUrl =
            'https://cdn.discordapp.com/embed/avatars/0.png';


        if (discordUser.avatar) {

            const extension =

                discordUser.avatar
                    .startsWith('a_')

                    ?

                'gif'

                    :

                'png';


            avatarUrl =

                `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.${extension}?size=256`;

        }


        document
            .getElementById(
                'mainAvatar'
            )
            .src =
                avatarUrl;


        document
            .getElementById(
                'cardAvatar'
            )
            .src =
                avatarUrl;



        /* =================================================
           USERNAME
        ================================================= */

        document
            .getElementById(
                'cardUsername'
            )
            .innerText =

                discordUser.username ||
                'Discord User';



        /* =================================================
           DECORATION
        ================================================= */

        const decoration =

            discordUser.avatar_decoration_data

            ||

            l.avatar_decoration_data;


        const avatarFrame =

            document.getElementById(
                'avatarFrame'
            );


        let hasDecoration =
            false;


        if (
            decoration &&
            decoration.asset
        ) {

            hasDecoration =
                true;


            const decorationUrl =

                `https://cdn.discordapp.com/avatar-decoration-presets/${decoration.asset}.png?size=240&passthrough=true`;


            if (
                avatarFrame.src !==
                decorationUrl
            ) {

                avatarFrame.src =
                    decorationUrl;

            }


            avatarFrame.style.display =
                'block';

        }

        else {

            avatarFrame.style.display =
                'none';

        }



        /* =================================================
           BADGES
        ================================================= */

        renderBadges(

            discordUser.public_flags,

            hasDecoration

        );



        /* =================================================
           STATUS
        ================================================= */

        const statusDot =

            document.getElementById(
                'statusDot'
            );


        const statusColors = {

            online:
                '#3ba55d',

            idle:
                '#faa81a',

            dnd:
                '#ed4245',

            offline:
                '#747f8d'

        };


        statusDot.style.backgroundColor =

            statusColors[
                l.discord_status
            ]

            ||

            '#747f8d';



        /* =================================================
           CUSTOM STATUS
        ================================================= */

        const custom =

            Array.isArray(
                l.activities
            )

            ?

            l.activities.find(
                activity =>
                    activity.type === 4
            )

            :

            null;


        const customStatus =

            document.getElementById(
                'customStatus'
            );


        if (
            custom &&
            custom.state
        ) {

            let statusText =
                custom.state;


            if (
                custom.emoji &&
                custom.emoji.name
            ) {

                statusText =

                    `${custom.emoji.name} ${statusText}`;

            }


            customStatus.innerText =
                statusText;

        }

        else {

            const prettyStatus = {

                online:
                    'online',

                idle:
                    'idle',

                dnd:
                    'dnd',

                offline:
                    'offline'

            };


            customStatus.innerText =

                prettyStatus[
                    l.discord_status
                ]

                ||

                'offline';

        }



        /* =================================================
           ACTIVITY ELEMENTS
        ================================================= */

        const activityBox =

            document.getElementById(
                'activityBox'
            );


        const activityHeader =

            document.getElementById(
                'activityHeader'
            );


        const activityTitle =

            document.getElementById(
                'activityTitle'
            );


        const activitySub =

            document.getElementById(
                'activitySub'
            );


        const activityState =

            document.getElementById(
                'activityState'
            );


        const progressContainer =

            document.getElementById(
                'progressContainer'
            );


        const currentTimeText =

            document.getElementById(
                'currentTimeText'
            );


        const totalTime =

            document.getElementById(
                'totalTime'
            );


        const spotifyBar =

            document.getElementById(
                'spotifyBar'
            );


        const gameSessionLine =

            document.getElementById(
                'gameSessionLine'
            );


        const barFill =

            document.getElementById(
                'barFill'
            );



        /*
            Eski timer varsa kapat
        */

        if (currentTimer) {

            clearInterval(
                currentTimer
            );


            currentTimer =
                null;

        }



        /* =================================================
           SPOTIFY
        ================================================= */

        if (
            l.listening_to_spotify &&
            l.spotify
        ) {

            activityBox.style.display =
                'block';


            activityHeader.innerText =
                'SPOTIFY DİNLİYOR';


            activityTitle.innerText =
                l.spotify.song ||
                'Spotify';


            activitySub.innerText =
                l.spotify.artist ||
                '';


            activityState.innerText =

                l.spotify.album

                ?

                l.spotify.album

                :

                '';


            setActivityImage(

                l.spotify.album_art_url,

                'fa-brands fa-spotify'

            );


            progressContainer.style.display =
                'flex';


            spotifyBar.style.display =
                'block';


            gameSessionLine.style.display =
                'none';


            totalTime.style.display =
                'block';



            const start =

                Number(
                    l.spotify.timestamps.start
                );


            const end =

                Number(
                    l.spotify.timestamps.end
                );


            const duration =

                Math.max(
                    end - start,
                    1
                );



            function spotifyTicker() {

                const elapsed =

                    Math.min(

                        Math.max(
                            Date.now() - start,
                            0
                        ),

                        duration

                    );


                const percentage =

                    (
                        elapsed /
                        duration
                    )

                    *

                    100;


                currentTimeText.innerText =

                    formatTime(
                        elapsed
                    );


                totalTime.innerText =

                    formatTime(
                        duration
                    );


                barFill.style.width =

                    `${percentage}%`;

            }


            spotifyTicker();


            currentTimer =

                setInterval(
                    spotifyTicker,
                    1000
                );


            return;

        }



        /* =================================================
           GAME ACTIVITY
        ================================================= */

        const game =

            Array.isArray(
                l.activities
            )

            ?

            l.activities.find(

                activity =>

                    activity.type === 0

            )

            :

            null;



        if (game) {

            activityBox.style.display =
                'block';


            activityHeader.innerText =
                'OYNUYOR';


            activityTitle.innerText =

                game.name ||
                'Oyun';


            /*
                Screenshot'taki gibi
                "Playing VALORANT"
                görünümü.
            */

            activitySub.innerText =

                game.details

                ||

                `Playing ${game.name}`;


            activityState.innerText =

                game.state &&
                game.state !== game.details

                ?

                game.state

                :

                '';


            const gameImage =

                resolveActivityAsset(
                    game
                );


            setActivityImage(

                gameImage,

                'fa-brands fa-discord'

            );


            if (
                game.timestamps &&
                game.timestamps.start
            ) {

                progressContainer.style.display =
                    'flex';


                spotifyBar.style.display =
                    'none';


                gameSessionLine.style.display =
                    'block';


                totalTime.style.display =
                    'block';


                totalTime.innerText =
                    'Aktif';


                const startedAt =

                    Number(
                        game.timestamps.start
                    );



                function gameTicker() {

                    const elapsed =

                        Date.now()
                        -
                        startedAt;


                    currentTimeText.innerText =

                        formatTime(
                            elapsed
                        );

                }


                gameTicker();


                currentTimer =

                    setInterval(
                        gameTicker,
                        1000
                    );

            }

            else {

                progressContainer.style.display =
                    'flex';


                spotifyBar.style.display =
                    'none';


                gameSessionLine.style.display =
                    'block';


                currentTimeText.innerText =
                    'Aktif';


                totalTime.innerText =
                    'Oynuyor';

            }


            return;

        }



        /* =================================================
           NO ACTIVITY
        ================================================= */

        activityBox.style.display =
            'none';


    }

    catch (error) {

        console.error(
            'Lanyard hatası:',
            error
        );

    }

}



/* ilk yükleme */

fetchLanyard();



/*
    Discord durumunu
    5 saniyede bir yenile.
*/

setInterval(
    fetchLanyard,
    5000
);



/* =========================================================
   ENTER + AUDIO
========================================================= */

const enterOverlay =

    document.getElementById(
        'enterOverlay'
    );


const bgVideo =

    document.getElementById(
        'bgVideo'
    );


const muteBtn =

    document.getElementById(
        'muteBtn'
    );


const volumeSlider =

    document.getElementById(
        'volumeSlider'
    );



enterOverlay.addEventListener(
    'click',
    () => {

        enterOverlay.style.opacity =
            '0';


        setTimeout(
            () => {

                enterOverlay.style.display =
                    'none';

            },
            500
        );


        bgVideo.muted =
            false;


        bgVideo.volume =
            Number(
                volumeSlider.value
            );


        bgVideo
            .play()
            .catch(error => {

                console.log(
                    'Video oynatma hatası:',
                    error
                );

            });

    }
);



/* =========================================================
   VOLUME SLIDER
========================================================= */

volumeSlider.addEventListener(
    'input',
    event => {

        const volume =

            Number(
                event.target.value
            );


        bgVideo.volume =
            volume;


        bgVideo.muted =
            volume === 0;


        updateVolumeIcon();

    }
);



/* =========================================================
   MUTE
========================================================= */

muteBtn.addEventListener(
    'click',
    () => {

        if (
            bgVideo.muted ||
            bgVideo.volume === 0
        ) {

            bgVideo.muted =
                false;


            let volume =

                Number(
                    volumeSlider.value
                );


            if (volume === 0) {

                volume =
                    0.5;


                volumeSlider.value =
                    '0.5';

            }


            bgVideo.volume =
                volume;

        }

        else {

            bgVideo.muted =
                true;

        }


        updateVolumeIcon();

    }
);



function updateVolumeIcon() {

    if (
        bgVideo.muted ||
        bgVideo.volume === 0
    ) {

        muteBtn.innerHTML =

            '<i class="fa-solid fa-volume-xmark"></i>';

        return;
    }


    if (
        bgVideo.volume <
        0.5
    ) {

        muteBtn.innerHTML =

            '<i class="fa-solid fa-volume-low"></i>';

        return;
    }


    muteBtn.innerHTML =

        '<i class="fa-solid fa-volume-high"></i>';

}


</script>


</body>

</html>